<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.glassfish.orb.baseline</groupId>
        <artifactId>orb-baseline</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>orb-baseline-relay</artifactId>
    <packaging>jar</packaging>

    <name>Baseline - a bean on one server that calls a bean on another</name>
    <description>
        Deployed to the first server. Its bean calls a bean on the second over
        this transport, inside whatever transaction the caller brought, which
        is the case two application servers make when they talk to each other.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.glassfish.orb.baseline</groupId>
            <artifactId>orb-baseline-bean</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>
        <!--
            Carried inside the archive rather than taken from the server's
            modules. The transport is there as OSGi bundles, and an ordinary
            application is not one: bundling the client is what makes this
            deployable without asking how the server's class loaders are wired.
        -->
        <dependency>
            <groupId>org.glassfish.main.orb</groupId>
            <artifactId>orb-http-client</artifactId>
            <version>8.0.5-SNAPSHOT</version>
            <exclusions>
                <!--
                    The server provides these. A second copy inside the archive
                    is how an application ends up with two of the same type and
                    a cast that cannot succeed.
                -->
                <exclusion>
                    <groupId>jakarta.ejb</groupId>
                    <artifactId>jakarta.ejb-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>jakarta.transaction</groupId>
                    <artifactId>jakarta.transaction-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.glassfish.main.orb</groupId>
            <artifactId>orb-http-protocol</artifactId>
            <version>8.0.5-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>orb-baseline-relay</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!--
                                An EJB jar, the same shape as the bean this
                                calls, with the transport client folded in. A
                                war would have been the tidier place for a
                                library, but the server refused it as an EJB
                                module, and an archive shape that is known to
                                deploy is worth more here than a tidier one.
                            -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>org.glassfish.main.orb:orb-http-client</include>
                                    <include>org.glassfish.main.orb:orb-http-protocol</include>
                                    <include>org.glassfish.orb.baseline:orb-baseline-bean</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <!--
                                        The interfaces only. A bean implements
                                        an interface its own class loader has to
                                        be able to see, and these live in the
                                        other deployment - which is a separate
                                        loader, so the container found a class
                                        it could not resolve and concluded the
                                        jar had no beans in it.

                                        The implementations are deliberately
                                        left out: bringing TxProbeBean along
                                        would deploy a second copy of it here,
                                        on the server that is supposed to be
                                        calling the far one.
                                    -->
                                    <artifact>org.glassfish.orb.baseline:orb-baseline-bean</artifact>
                                    <includes>
                                        <include>org/glassfish/orb/baseline/Relay.class</include>
                                        <include>org/glassfish/orb/baseline/TxProbe.class</include>
                                    </includes>
                                </filter>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
